{
  "name": "fork",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "state:get": "./get-state.sh",
    "state:download": "wget -O data/state.json ${STATE_SOURCE:-https://snapshots.play.hydration.cloud/state.json}",
    "state:scrape": "../../target/release/scraper save-chainspec --uri ${STATE_RPC:-wss://hydration-rpc.n.dwellir.com} ${STATE_BLOCK:+--at=${STATE_BLOCK}} --path ./ && mkdir -p data && mv SNAPSHOT.json data/state.json",
    "state:prepare": "node --max-old-space-size=8192 prepare-state-for-zombienet.js data/state.json data/forked-chainspec.json",
    "zombie:init": "NODE_OPTIONS=--max-old-space-size=8192 zombienet -l text -fd data spawn config.json",
    "para:alice": "tail -F data/alice-1.log",
    "para:bob": "tail -F data/bob-1.log",
    "relay:alice": "tail -F data/alice.log",
    "relay:bob": "tail -F data/bob.log",
    "relay:charlie": "tail -F data/charlie.log",
    "relay:dave": "tail -F data/dave.log",
    "zombienet": "run-p -lr zombie:init para:* relay:*",
    "start": "run-s -n state:get state:prepare zombienet",
    "start:raw": "run-s -n state:prepare zombienet"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@polkadot/types": "^15.0.2",
    "npm-run-all": "^4.1.5",
    "stream-json": "^1.8.0"
  }
}
